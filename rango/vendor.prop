# Bluetooth
persist.vendor.bluetooth.thread_dispatcher.enabled=true

# DCK
ro.gms.dck.eligible_wcc=3

# Display
ro.vendor.display.read_temp_interval=30
ro.vendor.primarydisplay.ambience.histogram_cols=4
ro.vendor.primarydisplay.preferred_mode=2152x2076x120@flag
ro.vendor.primarydisplay.xrr.blocking_zone.min_refresh_rate_by_nits=5:120
ro.vendor.primarydisplay.xrr.feat_present_timeout_enabled=true
ro.vendor.primarydisplay.xrr.version=2.1
ro.vendor.primarydisplay.xrr.vrr.expected_present.timeout_ns=500000000
ro.vendor.secondarydisplay.google-rgeb.temperature_path=/dev/thermal/tz-by-name/outer_disp_therm/temp
ro.vendor.secondarydisplay.preferred_mode=1080x2364x120@120
ro.vendor.secondarydisplay.xrr.version=1.1
vendor.display.async_off.supported=true

# Edge TPU
vendor.google.silicon.enable_iif_for_isolated_app=1
vendor.google.silicon.enable_iif_for_priv_app=1

# Media
ro.odm.build.media_performance_class=33

# SurfaceFlinger
debug.sf.set_idle_timer_ms_4619827677550801153=1500

# SVN
ro.vendor.build.svn=43

# Vibrator
persist.vendor.vibrator.hal.pwle.frequency.min_hz=60.0
persist.vendor.vibrator.hal.pwle.svc.mode=255
ro.vendor.vibrator.hal.bl.factor=0.98
ro.vendor.vibrator.hal.damping.q.factor=13.9
ro.vendor.vibrator.hal.device.mass=0.259
ro.vendor.vibrator.hal.dvl.lra.f0.v=1.2
ro.vendor.vibrator.hal.dvl.peq.coefficients=FE5E7,E00CFA,100EE9,F00B2F,1FF306,100000
ro.vendor.vibrator.hal.dvl.q.factor=4
ro.vendor.vibrator.hal.loc.coeff=2.98789
ro.vendor.vibrator.hal.lra.max.voltage=11
vendor.audio.hapticgenerator.distortion.output.gain=0.45

# Wi-Fi
ro.vendor.wifi.model=bcm4390
